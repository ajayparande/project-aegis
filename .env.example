
# Project Aegis - example configuration
# These are safe defaults. Never put real credentials here.

AEGIS_APP_NAME=Project Aegis
AEGIS_MODE=RESEARCH_ONLY
AEGIS_DATABASE_PATH=data/aegis.db
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_FILE=logs/aegis.log
AEGIS_ENABLE_LIVE_ORDERS=false

# Optional local credentials. Upstox needs no API key or secret.
UPSTOX_ACCESS_TOKEN=
# These initialize Zerodha configuration only; real connectivity remains disabled.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=